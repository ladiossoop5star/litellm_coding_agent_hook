+
+    result = hoist_images_from_tool_messages(messages)
+
+    assert result[1]["content"] == [{"type": "text", "text": "screenshot follows"}]
+    assert result[2]["content"] == [BOUNDARY_PART, {"type": "image_url", "image_url": {"url": DATA_URI_PNG}}]
